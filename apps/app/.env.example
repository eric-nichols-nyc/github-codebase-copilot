# Neon Postgres connection string (use the pooled host in serverless apps)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# GitHub REST API (import + repo list). Optional: GITHUB_ACCESS_TOKEN as fallback name.
GITHUB_TOKEN="ghp_..."
# Optional override for API requests (defaults to a descriptive app User-Agent).
# GITHUB_API_USER_AGENT="my-app/1.0 (+https://example.com)"
