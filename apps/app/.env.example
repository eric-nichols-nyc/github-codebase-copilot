# Neon Postgres connection string (use the pooled host in serverless apps)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (Console → Auth → copy Auth URL). Cookie secret: openssl rand -base64 32
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-characters-secret-value"
# Auth cookies are Secure. Use `pnpm dev` (HTTPS on port 3025), not `dev:http`, or sessions
# will not stick locally. Point GitHub/Neon redirect URLs at https://localhost:3025 when testing.
# BETTER_AUTH_URL="https://localhost:3025"

# GitHub REST API (import + repo list). Optional: GITHUB_ACCESS_TOKEN as fallback name.
GITHUB_TOKEN="ghp_..."
# Optional override for API requests (defaults to a descriptive app User-Agent).
# GITHUB_API_USER_AGENT="my-app/1.0 (+https://example.com)"
